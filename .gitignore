# Segredos
.env
homeassistant/secrets.yaml
mosquitto/config/passwd

# Estado/runtime do Home Assistant (é recriado ou vai no backup, não no git)
homeassistant/.storage/
homeassistant/.cloud/
homeassistant/.HA_VERSION
