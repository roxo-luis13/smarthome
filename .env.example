# Copie este arquivo para ".env" e ajuste os valores:
#   cp .env.example .env
# O arquivo .env NÃO vai para o git (contém senhas).

# Fuso horário (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Sao_Paulo

# Usuário e senha do broker MQTT (invente uma senha forte)
MQTT_USER=casa
MQTT_PASSWORD=troque-esta-senha

# Versões das imagens. "stable"/"latest" = sempre a mais nova ao atualizar.
# Para travar numa versão específica, use por exemplo HA_VERSION=2026.9.1
HA_VERSION=stable
Z2M_VERSION=latest

# Serviços opcionais. Deixe vazio para rodar só Home Assistant + MQTT.
# Com adaptador Zigbee USB conectado, use: COMPOSE_PROFILES=zigbee
COMPOSE_PROFILES=

# Somente se usar Zigbee: caminho do adaptador USB no host.
# Prefira o caminho estável em /dev/serial/by-id/ (veja docs/05-zigbee.md)
ZIGBEE_DEVICE=/dev/ttyUSB0
